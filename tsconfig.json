{
    "compilerOptions": {
        "strict": true,
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "module": "ES2020",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "rootDir": "src",
        "outDir": "dist/js",
        "noEmitOnError": true,
        "jsx": "react",
        "typeRoots": ["node_modules/@types"],
        "types": ["chrome"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}
